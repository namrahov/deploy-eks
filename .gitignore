# ---------- Terraform ----------
# The state file holds the DB password in PLAINTEXT - never commit it.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Real values (password, account ID, domain...). Only .example gets committed.
terraform.tfvars
*.auto.tfvars
!terraform.tfvars.example

# Plan files contain sensitive values too
*.tfplan
tfplan

# NOTE: .terraform.lock.hcl is NOT LISTED HERE - because it MUST BE COMMITTED.
# It pins the provider versions; everyone on the team gets the same versions.

# ---------- Local ----------
.env
*.pem
