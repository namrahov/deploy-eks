project            = "my-springboot-eks"
region             = "eu-north-1"
kubernetes_version = "1.34"

# true  = EKS Auto Mode (tovsiye olunur)
# false = klassik managed node group (Kubernetes daxilini oyrenmek ucun)
use_auto_mode = true

db_name           = "appdb"
db_username       = "appuser"
db_instance_class = "db.t4g.micro"
db_multi_az       = false

# AWS "Free Tier" planindaki hesab? Console -> Billing -> Free tier / Account plan.
# true olanda avtomatik backup, storage autoscaling, CloudWatch log export ve
# Performance Insights sondurulur - yoxsa apply FreeTierRestrictionError verir.
free_tier_account = true

# db.t4g.micro/small-da Performance Insights DESTEKLENMIR - true etsen
# apply "InvalidParameterCombination" ile dusur. Instance boyudende ac.
# QEYD: free_tier_account = true olanda bu deyer nezere alinmir (hemise sonulu).
db_performance_insights = false
