project            = "my-springboot-eks"
region             = "eu-north-1"
kubernetes_version = "1.34"

# true  = EKS Auto Mode (tovsiye olunur)
# false = klassik managed node group (Kubernetes daxilini oyrenmek ucun)
use_auto_mode = true

db_name           = "appdb"
db_username       = "appuser"
db_instance_class = "db.t4g.micro"
db_multi_az       = false

# db.t4g.micro/small-da Performance Insights DESTEKLENMIR - true etsen
# apply "InvalidParameterCombination" ile dusur. Instance boyudende ac.
db_performance_insights = false
