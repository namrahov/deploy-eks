project            = "my-springboot-eks"
region             = "eu-north-1"
kubernetes_version = "1.34"

# true  = EKS Auto Mode (recommended)
# false = classic managed node group (to learn the Kubernetes internals)
use_auto_mode = true

db_name           = "appdb"
db_username       = "appuser"
db_instance_class = "db.t4g.micro"
db_multi_az       = false

# Is the account on the AWS "Free Tier" plan? Console -> Billing -> Free tier / Account plan.
# When true, automated backups, storage autoscaling, CloudWatch log export and
# Performance Insights are disabled - otherwise apply fails with FreeTierRestrictionError.
free_tier_account = true

# Performance Insights is NOT SUPPORTED on db.t4g.micro/small - if you set true,
# apply fails with "InvalidParameterCombination". Enable it once you size up.
# NOTE: when free_tier_account = true this value is ignored (always disabled).
db_performance_insights = false
